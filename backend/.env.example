# FarmShield AI Backend - Environment Configuration Template
# Copy this file to .env and adjust variables as required. Never commit actual secrets!

# Application Configuration
APP_NAME="FarmShield AI Backend"
APP_ENV=development
DEBUG=True
VERSION=1.0.0
API_V1_STR=/api/v1

# PostgreSQL + PostGIS Docker Configuration
POSTGRES_DB=farmshield_db
POSTGRES_USER=farmshield
POSTGRES_PASSWORD=farmshield_password_change_in_production
POSTGRES_PORT=5432

# SQLAlchemy 2.x Database Connection URL (psycopg3 driver)
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=True
DB_CONNECT_TIMEOUT=3

# Security & JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-32-character-secret-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=farmshield-ai
JWT_AUDIENCE=farmshield-app
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://farmfield-ai.vercel.app
