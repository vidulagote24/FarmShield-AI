# FarmShield AI Frontend Environment Configuration

# Data Provider Mode:
# "demo" (default: loads offline digital twin fixtures without live network requests)
# "live" (connects to FastAPI backend REST API under /api/v1)
VITE_DATA_MODE=demo

# API Base URL for FastAPI backend (REQUIRED when running Live Mode in production):
# For local development: http://localhost:8000/api/v1
# For Vercel production: https://<deployed-backend-domain>/api/v1 (MUST NOT point to localhost)
VITE_API_BASE_URL=http://localhost:8000/api/v1

